# ─── Public Firebase web config ───────────────────────────────────────────────
# These are exposed to the browser (NEXT_PUBLIC_ prefix is intentional).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (SERVER-ONLY — never use NEXT_PUBLIC_ prefix) ─────────────
# Option A: paste the entire service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (recommended for Vercel): set the three fields separately.
# Copy the values from your Firebase service-account JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key exactly as it appears in the JSON (with literal \n sequences).
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── OpenAI (SERVER-ONLY) ──────────────────────────────────────────────────────
# Used by /api/analyze for AI match analysis.
# If omitted or set to the placeholder value, the app falls back to local analysis.
OPENAI_API_KEY=

# ─── Pakasir (SERVER-ONLY) ────────────────────────────────────────────────────
# Your Pakasir project slug (e.g. my-project).
PAKASIR_PROJECT=
# Your Pakasir API key — keep this secret, never prefix with NEXT_PUBLIC_.
PAKASIR_API_KEY=
# Optional: webhook secret to validate incoming Pakasir webhook calls.
PAKASIR_WEBHOOK_SECRET=

# ─── App URL (public) ─────────────────────────────────────────────────────────
# Set this to your production URL before deploying (used for payment redirects).
# Example: https://yourapp.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
